+    private static double getRecipeChoiceValue(Object choice, List<String> history, int nesting, boolean multiplier) {
+        if (choice == null) return 0;
+        if (choice instanceof ItemStack is) {
+            return getItemValueVanilla(is, history, nesting, multiplier);
+        }
+        if (choice instanceof Material mat) {
+            return getItemValueVanilla(new ItemStack(mat), history, nesting, multiplier);
+        }
+        if (choice instanceof RecipeChoice) {
+            try {
+                Method getItemStack = findMethod(choice.getClass(), "getItemStack");
+                if (getItemStack != null) {
+                    try {
+                        ItemStack is = (ItemStack) getItemStack.invoke(choice);
+                        if (is != null && is.getType() != Material.AIR) {
+                            double v = getItemValueVanilla(is, history, nesting, multiplier);
+                            if (v > 0) return v;
+                        }
+                    } catch (Throwable ignored) {}
+                }
+            } catch (Throwable ignored) {}
+            try {
+                Method getChoices = findMethod(choice.getClass(), "getChoices");
+                if (getChoices != null) {
+                    Object obj = getChoices.invoke(choice);
+                    if (obj instanceof List) {
+                        List<?> list = (List<?>) obj;
+                        double best = 0;
+                        for (Object o : list) {
+                            double v = 0;
+                            if (o instanceof ItemStack is2) v = getItemValueVanilla(is2, history, nesting, multiplier);
+                            else if (o instanceof Material m2) v = getItemValueVanilla(new ItemStack(m2), history, nesting, multiplier);
+                            if (v > 0 && (best == 0 || v < best)) best = v;
+                        }
+                        if (best > 0) return best;
+                    }
+                }
+            } catch (Throwable ignored) {}
+            if (choice instanceof RecipeChoice.MaterialChoice mc) {
+                double best = 0;
+                for (Material m : mc.getChoices()) {
+                    double v = getItemValueVanilla(new ItemStack(m), history, nesting, multiplier);
+                    if (v > 0 && (best == 0 || v < best)) best = v;
+                }
+                return best;
+            }
+            if (choice instanceof RecipeChoice.ExactChoice ec) {
+                double best = 0;
+                for (ItemStack is : ec.getChoices()) {
+                    double v = getItemValueVanilla(is, history, nesting, multiplier);
+                    if (v > 0 && (best == 0 || v < best)) best = v;
+                }
+                return best;
+            }
+        }
+        return 0;
+    }
+
+    private static Method findMethod(Class<?> clazz, String name) {
+        try {
+            for (Method m : clazz.getMethods()) {
+                if (m.getName().equals(name) && m.getParameterCount() == 0) return m;
+            }
+        } catch (Throwable ignored) {}
+        return null;
     }
 
