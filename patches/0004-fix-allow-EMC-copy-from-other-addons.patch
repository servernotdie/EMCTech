+            }
+        } catch (Exception ignored) {}
+    }
+
+    /**
+     * Kiểm tra RecipeType có được phép tính EMC tự động không.
+     * Sau bản vá: cho phép tất cả trừ NULL để hỗ trợ mọi addon.
+     * @deprecated ALLOWABLE_RECIPE_TYPES giờ chỉ giữ để tương thích, nên dùng isRecipeTypeAllowed
+     */
+    public static boolean isRecipeTypeAllowed(@Nonnull RecipeType recipeType) {
+        if (recipeType == RecipeType.NULL) {
+            return false;
+        }
+        // Cho phép tất cả RecipeType khác (ENHANCED_CRAFTING_TABLE, custom Supreme, Fluffy, v.v.)
+        return true;
+        // Logic cũ: return ALLOWABLE_RECIPE_TYPES.contains(recipeType);
     }
 
