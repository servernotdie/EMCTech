+    @Subcommand("enable")
+    @Description("Bật bảng điểm EMC")
+    public void enableScoreboard(CommandSender sender) {
+        if (sender instanceof Player player) {
+            ScoreboardManager mgr = ScoreboardManager.getInstance();
+            if (mgr == null) {
+                player.sendMessage(Theme.ERROR + "Hệ thống bảng điểm chưa sẵn sàng.");
+                return;
+            }
+            if (mgr.isEnabled(player)) {
+                player.sendMessage(Theme.WARNING + "Bảng điểm EMC đã được bật rồi.");
+            } else {
+                mgr.setEnabled(player, true);
+                player.sendMessage(Theme.SUCCESS + "Đã bật bảng điểm EMC!");
+            }
+        } else {
+            sendPlayerOnlyMessage(sender);
+        }
+    }
+
+    @Subcommand("disable")
+    @Description("Tắt bảng điểm EMC")
+    public void disableScoreboard(CommandSender sender) {
+        if (sender instanceof Player player) {
+            ScoreboardManager mgr = ScoreboardManager.getInstance();
+            if (mgr == null) {
+                player.sendMessage(Theme.ERROR + "Hệ thống bảng điểm chưa sẵn sàng.");
+                return;
+            }
+            if (!mgr.isEnabled(player)) {
+                player.sendMessage(Theme.WARNING + "Bảng điểm EMC đã tắt rồi.");
+            } else {
+                mgr.setEnabled(player, false);
+                player.sendMessage(Theme.SUCCESS + "Đã tắt bảng điểm EMC!");
+            }
+        } else {
+            sendPlayerOnlyMessage(sender);
+        }
+    }
+
     public void sendPlayerOnlyMessage(CommandSender sender) {
         sender.sendMessage(Theme.ERROR + "Chỉ người chơi mới có thể thực thi lệnh này.");
     }
 }
