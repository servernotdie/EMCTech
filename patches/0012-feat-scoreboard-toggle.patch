diff --git a/src/main/java/io/github/sefiraat/emctech/managers/ScoreboardManager.java b/src/main/java/io/github/sefiraat/emctech/managers/ScoreboardManager.java
new file mode 100644
index 0000000..ac36da3
--- /dev/null
+++ b/src/main/java/io/github/sefiraat/emctech/managers/ScoreboardManager.java
@@ -0,0 +1,288 @@
+package io.github.sefiraat.emctech.managers;
+
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.logging.Level;
+
+import javax.annotation.Nonnull;
+
+import org.bukkit.Bukkit;
+import org.bukkit.ChatColor;
+import org.bukkit.entity.Player;
+import org.bukkit.scoreboard.Criteria;
+import org.bukkit.scoreboard.DisplaySlot;
+import org.bukkit.scoreboard.Objective;
+import org.bukkit.scoreboard.Score;
+import org.bukkit.scoreboard.Scoreboard;
+
+import io.github.sefiraat.emctech.EmcTech;
+import io.github.sefiraat.emctech.emc.EmcStorage;
+import io.github.sefiraat.emctech.utils.EmcUtils;
+import io.github.sefiraat.emctech.utils.Theme;
+
+public final class ScoreboardManager {
+
+    private static ScoreboardManager instance;
+
+    private final Set<UUID> enabledPlayers = ConcurrentHashMap.newKeySet();
+    private final Map<UUID, Scoreboard> activeBoards = new ConcurrentHashMap<>();
+    private final Map<UUID, Long> lastWarnTime = new ConcurrentHashMap<>();
+    private static final long WARN_COOLDOWN_MS = 30000L;
+
+    public ScoreboardManager() {
+        instance = this;
+        loadEnabled();
+    }
+
+    private void loadEnabled() {
+        try {
+            for (String key : ConfigManager.getScoreboardData().singleLayerKeySet()) {
+                try {
+                    if (ConfigManager.getScoreboardData().getBoolean(key)) {
+                        enabledPlayers.add(UUID.fromString(key));
+                    }
+                } catch (Exception ignored) {
+                }
+            }
+        } catch (Exception e) {
+            EmcTech.getInstance().getLogger().log(Level.WARNING, "Không thể load scoreboard data: " + e.getMessage(), e);
+        }
+    }
+
+    public static ScoreboardManager getInstance() {
+        return instance;
+    }
+
+    public boolean isEnabled(@Nonnull Player player) {
+        return isEnabled(player.getUniqueId());
+    }
+
+    public boolean isEnabled(@Nonnull UUID uuid) {
+        return enabledPlayers.contains(uuid);
+    }
+
+    public void setEnabled(@Nonnull Player player, boolean enabled) {
+        setEnabled(player.getUniqueId(), enabled);
+        if (enabled) {
+            runOnPlayer(player, () -> createBoardInternal(player));
+        } else {
+            runOnPlayer(player, () -> removeBoardInternal(player));
+        }
+    }
+
+    public void setEnabled(@Nonnull UUID uuid, boolean enabled) {
+        String path = uuid.toString();
+        if (enabled) {
+            enabledPlayers.add(uuid);
+            ConfigManager.getScoreboardData().getFileData().insert(path, true);
+        } else {
+            enabledPlayers.remove(uuid);
+            activeBoards.remove(uuid);
+            lastWarnTime.remove(uuid);
+            try {
+                ConfigManager.getScoreboardData().remove(path);
+            } catch (Exception ignored) {
+                ConfigManager.getScoreboardData().getFileData().insert(path, false);
+                ConfigManager.getScoreboardData().remove(path);
+            }
+        }
+        try {
+            ConfigManager.getInstance().saveScoreboard();
+        } catch (Exception e) {
+            try {
+                ConfigManager.getScoreboardData().write();
+            } catch (Exception ignored) {
+            }
+        }
+    }
+
+    public void createBoard(@Nonnull Player player) {
+        runOnPlayer(player, () -> createBoardInternal(player));
+    }
+
+    private void createBoardInternal(@Nonnull Player player) {
+        try {
+            if (!player.isOnline()) return;
+            if (Bukkit.getScoreboardManager() == null) {
+                warnThrottled(player.getUniqueId(), "ScoreboardManager chưa sẵn sàng (getScoreboardManager null) cho " + player.getName(), null);
+                return;
+            }
+            Scoreboard board = Bukkit.getScoreboardManager().getNewScoreboard();
+            if (board == null) {
+                warnThrottled(player.getUniqueId(), "Không thể tạo Scoreboard mới cho " + player.getName(), null);
+                return;
+            }
+            Objective objective;
+            try {
+                objective = board.registerNewObjective("emc", Criteria.DUMMY, ChatColor.GOLD + "" + ChatColor.BOLD + "EMC");
+            } catch (Throwable t) {
+                objective = board.registerNewObjective("emc", "dummy", ChatColor.GOLD + "" + ChatColor.BOLD + "EMC");
+            }
+            if (objective == null) {
+                warnThrottled(player.getUniqueId(), "Không thể tạo Objective cho " + player.getName(), null);
+                return;
+            }
+            objective.setDisplaySlot(DisplaySlot.SIDEBAR);
+            updateBoardInternal(player, board, objective);
+            activeBoards.put(player.getUniqueId(), board);
+            player.setScoreboard(board);
+            lastWarnTime.remove(player.getUniqueId());
+        } catch (Exception e) {
+            warnThrottled(player.getUniqueId(), "Không thể tạo scoreboard cho " + player.getName() + ": " + e, e);
+        } catch (Throwable t) {
+            warnThrottled(player.getUniqueId(), "Không thể tạo scoreboard cho " + player.getName() + ": " + t, t);
+        }
+    }
+
+    public void removeBoard(@Nonnull Player player) {
+        runOnPlayer(player, () -> removeBoardInternal(player));
+    }
+
+    private void removeBoardInternal(@Nonnull Player player) {
+        try {
+            activeBoards.remove(player.getUniqueId());
+            lastWarnTime.remove(player.getUniqueId());
+            if (Bukkit.getScoreboardManager() == null) return;
+            try {
+                player.setScoreboard(Bukkit.getScoreboardManager().getMainScoreboard());
+            } catch (Exception ignored) {
+                try {
+                    player.setScoreboard(Bukkit.getScoreboardManager().getNewScoreboard());
+                } catch (Exception ignored2) {
+                }
+            }
+        } catch (Exception e) {
+            warnThrottled(player.getUniqueId(), "Không thể xóa scoreboard cho " + player.getName() + ": " + e, e);
+        }
+    }
+
+    public void updateBoard(@Nonnull Player player) {
+        if (!isEnabled(player)) return;
+        runOnPlayer(player, () -> updateBoardInternal(player));
+    }
+
+    private void updateBoardInternal(@Nonnull Player player) {
+        if (!isEnabled(player)) return;
+        if (!player.isOnline()) return;
+        Scoreboard board = activeBoards.get(player.getUniqueId());
+        if (board == null || player.getScoreboard() != board) {
+            createBoardInternal(player);
+            return;
+        }
+        Objective objective = board.getObjective("emc");
+        if (objective == null) {
+            createBoardInternal(player);
+            return;
+        }
+        updateBoardInternal(player, board, objective);
+    }
+
+    private void updateBoardInternal(@Nonnull Player player, @Nonnull Scoreboard board, @Nonnull Objective objective) {
+        try {
+            for (String entry : board.getEntries()) {
+                board.resetScores(entry);
+            }
+            double emc = EmcStorage.getEmc(player);
+            String formatted = EmcUtils.EMC_FORMAT.format(emc);
+            String line1 = ChatColor.YELLOW + "EMC: " + ChatColor.WHITE + formatted;
+            Score score1 = objective.getScore(line1);
+            score1.setScore(1);
+            Score empty = objective.getScore(ChatColor.GRAY + "§8§m--------------------");
+            empty.setScore(0);
+            try {
+                objective.setDisplayName(ChatColor.GOLD + "" + ChatColor.BOLD + "EMC " + ChatColor.WHITE + "✦");
+            } catch (Throwable ignored) {
+            }
+        } catch (Exception e) {
+            warnThrottled(player.getUniqueId(), "Không thể cập nhật scoreboard cho " + player.getName() + ": " + e, e);
+        }
+    }
+
+    public void updateAll() {
+        for (UUID uuid : enabledPlayers) {
+            Player player = Bukkit.getPlayer(uuid);
+            if (player != null && player.isOnline()) {
+                updateBoard(player);
+            }
+        }
+    }
+
+    public void handleJoin(@Nonnull Player player) {
+        if (isEnabled(player)) {
+            runOnPlayer(player, () -> createBoardInternal(player));
+        }
+    }
+
+    public void handleQuit(@Nonnull Player player) {
+        activeBoards.remove(player.getUniqueId());
+        lastWarnTime.remove(player.getUniqueId());
+    }
+
+    public void disableAll() {
+        for (UUID uuid : new java.util.HashSet<>(enabledPlayers)) {
+            Player player = Bukkit.getPlayer(uuid);
+            if (player != null && player.isOnline()) {
+                runOnPlayer(player, () -> {
+                    try {
+                        if (Bukkit.getScoreboardManager() != null) {
+                            player.setScoreboard(Bukkit.getScoreboardManager().getMainScoreboard());
+                        }
+                    } catch (Exception ignored) {
+                    }
+                });
+            }
+        }
+        activeBoards.clear();
+        lastWarnTime.clear();
+    }
+
+    public int getEnabledCount() {
+        return enabledPlayers.size();
+    }
+
+    private void runOnPlayer(@Nonnull Player player, @Nonnull Runnable action) {
+        try {
+            // Ưu tiên Folia entity scheduler nếu có
+            if (EmcTech.getFoliaLib() != null) {
+                EmcTech.getFoliaLib().getScheduler().runAtEntity(player, (task) -> {
+                    try {
+                        action.run();
+                    } catch (Exception e) {
+                        warnThrottled(player.getUniqueId(), "Lỗi scoreboard task cho " + player.getName() + ": " + e, e);
+                    }
+                });
+                return;
+            }
+        } catch (Throwable ignored) {
+        }
+        try {
+            // Fallback Paper/Spigot: chạy trên main thread
+            if (Bukkit.isPrimaryThread()) {
+                action.run();
+            } else {
+                Bukkit.getScheduler().runTask(EmcTech.getInstance(), action);
+            }
+        } catch (Throwable t) {
+            try {
+                action.run();
+            } catch (Exception ignored) {
+            }
+        }
+    }
+
+    private void warnThrottled(@Nonnull UUID uuid, @Nonnull String msg, Throwable t) {
+        long now = System.currentTimeMillis();
+        Long last = lastWarnTime.get(uuid);
+        if (last != null && now - last < WARN_COOLDOWN_MS) {
+            return;
+        }
+        lastWarnTime.put(uuid, now);
+        if (t != null) {
+            EmcTech.getInstance().getLogger().log(Level.WARNING, msg, t);
+        } else {
+            EmcTech.getInstance().getLogger().warning(msg);
+        }
+    }
+}
