+package io.github.sefiraat.emctech.listeners;
+
+import org.bukkit.entity.Player;
+import org.bukkit.event.EventHandler;
+import org.bukkit.event.Listener;
+import org.bukkit.event.player.PlayerJoinEvent;
+import org.bukkit.event.player.PlayerQuitEvent;
+
+import io.github.sefiraat.emctech.managers.ScoreboardManager;
+
+public class ScoreboardListener implements Listener {
+
+    @EventHandler
+    public void onJoin(PlayerJoinEvent event) {
+        Player player = event.getPlayer();
+        try {
+            ScoreboardManager manager = ScoreboardManager.getInstance();
+            if (manager != null && manager.isEnabled(player)) {
+                manager.handleJoin(player);
+            }
+        } catch (Exception ignored) {
+        }
+    }
+
+    @EventHandler
+    public void onQuit(PlayerQuitEvent event) {
+        Player player = event.getPlayer();
+        try {
+            ScoreboardManager manager = ScoreboardManager.getInstance();
+            if (manager != null) {
+                manager.handleQuit(player);
+            }
+        } catch (Exception ignored) {
+        }
+    }
+}
