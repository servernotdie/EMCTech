-    public void saveAll() {
+    public synchronized void saveAll() {
         EmcTech.getInstance().getLogger().info("Đang lưu tất cả dữ liệu của EMC.");
-        this.playerEmc.write();
-        this.playerLearnedItems.write();
+        backupAndWrite(this.playerEmc);
